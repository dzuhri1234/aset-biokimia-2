# Salin fail ini ke .env (untuk pembangunan tempatan) dan isikan nilai sebenar
# daripada Supabase Dashboard > Project Settings > API.
#
# JANGAN commit fail .env ke Git - .gitignore sudah mengecualikannya.
# Untuk GitHub Pages, nilai ini disuntik melalui GitHub Actions Secrets
# semasa proses build (lihat .github/workflows/deploy.yml).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
